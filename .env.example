# Copy to .env and fill in what you need. Everything is optional.

# ---- General ----
TZ=Europe/Budapest
APP_PORT=3000
# BIND_ADDR=0.0.0.0          # expose on all interfaces (VM) — set DASHBOARD_PASSWORD too!
# DASHBOARD_PASSWORD=change-me  # enables HTTP Basic auth (any username)

# ---- Database ----
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# ---- AI (any OpenAI-compatible API) ----
# xAI Grok (default):  https://api.x.ai/v1   — key: https://console.x.ai
# OpenAI:              https://api.openai.com/v1
# Local Ollama:        http://host.docker.internal:11434/v1  (no key needed, mail never leaves your machine)
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4

# ---- Mail bot (IMAP, use an app password) ----
# Gmail: imap.gmail.com   iCloud: imap.mail.me.com   Outlook: outlook.office365.com
SECRET_IMAP_HOST=imap.gmail.com
SECRET_IMAP_USER=
SECRET_IMAP_PASSWORD=

# ---- Secrets for the API connector / calendar ----
# Anything named SECRET_<NAME> can be referenced in widget settings as {{secret:<NAME>}}
# SECRET_NEWSAPI_KEY=
# SECRET_GCAL_PRIVATE_ICS=https://calendar.google.com/calendar/ical/.../private-xxxx/basic.ics
