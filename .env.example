# Copy to .env and fill in what you need. Everything is optional.

# ---- General ----
TZ=Europe/Budapest
APP_PORT=3000
# BIND_ADDR=0.0.0.0          # expose on all interfaces (VM) — set DASHBOARD_PASSWORD too!
# DASHBOARD_PASSWORD=change-me  # enables HTTP Basic auth (any username)

# ---- Public HTTPS on a VM: docker compose --profile public up -d ----
# The domain's A record must point to the VM. Requires DASHBOARD_PASSWORD (12+ characters).
# DOMAIN=dash.example.com

# --- Cloudflare Tunnel (private access from anywhere, no open ports) ---
# Token from Cloudflare Zero Trust -> Networks -> Tunnels; start with: docker compose --profile tunnel up -d
# TUNNEL_TOKEN=

# Which optional services `docker compose up -d` starts by itself (tunnel, ollama, public):
# COMPOSE_PROFILES=tunnel,ollama

# ---- Database ----
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# ---- AI (any OpenAI-compatible API) ----
# Easiest: set provider / key / model in the dashboard (header → AI). These are only the fallback.
# xAI Grok (default):  https://api.x.ai/v1   — key: https://console.x.ai
# OpenAI:              https://api.openai.com/v1
# Local Ollama:        http://host.docker.internal:11434/v1  (no key needed, mail never leaves your machine)
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4
# model that can read images (Portfólió screenshot import), e.g. qwen2.5vl:3b; empty = LLM_MODEL
LLM_VISION_MODEL=

# ---- Látványterv: local ComfyUI (Desktop app: port 8000, manual install: 8188) ----
# Can also be set per tile in its settings.
# COMFYUI_URL=http://host.docker.internal:8000

# ---- Mail bot (IMAP, use an app password) ----
# Gmail: imap.gmail.com   iCloud: imap.mail.me.com   Outlook: outlook.office365.com
SECRET_IMAP_HOST=imap.gmail.com
SECRET_IMAP_USER=
SECRET_IMAP_PASSWORD=

# ---- Secrets for the API connector / calendar ----
# Anything named SECRET_<NAME> can be referenced in widget settings as {{secret:<NAME>}}
# Stocks tile — free key at https://twelvedata.com (without it the tile uses Yahoo Finance, no key)
# SECRET_TWELVEDATA_KEY=
# TWELVEDATA_CREDITS_PER_MIN=8   # raise on paid plans
# Home Assistant tile
# SECRET_HA_URL=http://homeassistant.local:8123
# SECRET_HA_TOKEN=
# GitHub tile (private repos / higher rate limit)
# SECRET_GITHUB_TOKEN=
# SECRET_NEWSAPI_KEY=
# SECRET_GCAL_PRIVATE_ICS=https://calendar.google.com/calendar/ical/.../private-xxxx/basic.ics
